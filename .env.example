DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=long-random-string
SITE_PASSWORD=your-site-password
# Comma-separated admin emails only these can open /admin
ADMIN_EMAILS=admin@example.com,other@example.com
RESEND_API_KEY=re_xxxx
EMAIL_FROM=DiamondClaim <noreply@yourdomain.com>
CRON_SECRET=long-random-string

# Steel live browser (interactive CMC login on Vercel/Render)
STEEL_API_KEY=ste-xxxx

# Optional: mirror every auto-push to a second GitHub repo
GITHUB_MIRROR_URL=https://github.com/<user>/<repo>.git
GITHUB_MIRROR_TOKEN=ghp_xxxx
